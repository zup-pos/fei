local config = {
    sourceFile = "/storage/emulated/0/长安/配置文件/animconf",
    targetFile = "/storage/emulated/0/长安/图片/animconf"
}

local function checkFile(path)
    local f = io.open(path, "rb")
    if not f then return false, 0 end
    local s = f:seek("end")
    f:close()
    return true, s
end

local function overwriteFile()
    local e, s = checkFile(config.sourceFile)
    if not e or s == 0 or config.sourceFile == config.targetFile then return end
    
    local f = io.open(config.sourceFile, "rb")
    if not f then return end
    local c = f:read("*a")
    f:close()
    
    os.execute("mkdir -p '"..config.targetFile:match("^(.-)[^/]+$").."'")
    
    local o = io.open(config.targetFile, "wb")
    if o then
        o:write(c)
        o:close()
    end
end

overwriteFile()